---
import { asset, link } from '../utils/asset';
interface Props {
  size?: 'sm' | 'md' | 'lg';
  variant?: 'default' | 'white';
}
const { size = 'md', variant = 'default' } = Astro.props;

const heights = { sm: '32px', md: '42px', lg: '56px' };
const widths = { sm: 100, md: 131, lg: 174 };
const textSizes = { sm: '1rem', md: '1.2rem', lg: '1.5rem' };
const textColor = variant === 'white' ? '#ffffff' : '#3D3D3D';
---

<a href={link('/')} class="inline-flex items-center gap-3 hover:opacity-90 transition-opacity" aria-label="MG Couverture — Accueil">
  <img
    src={asset('/images/logo.png')}
    alt="Logo MG Couverture — trois maisons avec toits rouges"
    width={widths[size]}
    height={size === 'sm' ? 32 : size === 'md' ? 42 : 56}
    style={`height: ${heights[size]}; width: auto;`}
    loading="eager"
    class={variant === 'white' ? 'brightness-0 invert' : ''}
  />
  <span
    class="font-bold leading-tight"
    style={`font-size: ${textSizes[size]}; color: ${textColor};`}
  >
    <span style={`color: ${variant === 'white' ? '#ffffff' : '#C8102E'};`}>MG</span> Couverture
  </span>
</a>
