---
import Logo from './Logo.astro';
import { link } from '../utils/asset';
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#3D3D3D] text-gray-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <div class="mb-4">
          <Logo size="md" variant="white" />
        </div>
        <p class="text-xs text-gray-300 italic mb-2">Couverture – Zinguerie – Isolation</p>
        <p class="text-sm leading-relaxed mb-4">
          Artisan couvreur indépendant à Orléans et dans toute l'agglomération orléanaise. Devis gratuit et intervention rapide.
        </p>
        <a
          href="https://www.facebook.com/p/MG-Couverture-100076450502585/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-red-300 hover:text-white transition-colors text-sm"
          aria-label="MG Couverture sur Facebook"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          Suivez-nous sur Facebook
        </a>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="font-semibold text-white mb-4">Navigation</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={link('/')} class="hover:text-white transition-colors">Accueil</a></li>
          <li><a href={link('/services')} class="hover:text-white transition-colors">Nos services</a></li>
          <li><a href={link('/realisations')} class="hover:text-white transition-colors">Réalisations</a></li>
          <li><a href={link('/a-propos')} class="hover:text-white transition-colors">À propos</a></li>
          <li><a href={link('/contact')} class="hover:text-white transition-colors">Contact & Devis</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-semibold text-white mb-4">Contact</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-[#C8102E] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href="tel:0670635484" class="hover:text-white transition-colors">06.70.63.54.84</a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-[#C8102E] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href="mailto:mgcouverture45@gmail.com" class="hover:text-white transition-colors">mgcouverture45@gmail.com</a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-[#C8102E] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>Gidy (45520) — Orléans et agglomération</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-600 mt-10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-gray-300">
      <p>© {currentYear} MG Couverture — Mickaël Grenêche. Tous droits réservés.</p>
      <a href="https://github.com/0xNic0lay" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Création web · NGDev</a>
      <div class="flex gap-4">
        <a href={link('/mentions-legales')} class="hover:text-white transition-colors">Mentions légales</a>
        <a href={link('/politique-confidentialite')} class="hover:text-white transition-colors">Politique de confidentialité</a>
      </div>
    </div>
  </div>
</footer>
