---
import Logo from './Logo.astro';
import { link } from '../utils/asset';

const navLinks = [
  { href: link('/'), label: 'Accueil' },
  { href: link('/services'), label: 'Services' },
  { href: link('/realisations'), label: 'Réalisations' },
  { href: link('/a-propos'), label: 'À propos' },
  { href: link('/contact'), label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16 md:h-20">
      <Logo size="md" />

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Navigation principale">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${
              currentPath === link.href
                ? 'text-[#C8102E] font-semibold'
                : 'text-[#5a5a5a] hover:text-[#C8102E]'
            }`}
          >
            {link.label}
          </a>
        ))}
        <a href={link('/contact')} class="ml-3 btn-primary text-sm px-5 py-2.5">
          Devis gratuit
        </a>
      </nav>

      <!-- Mobile menu button -->
      <button
        id="menu-toggle"
        class="md:hidden p-2 rounded-md text-[#5a5a5a] hover:text-[#C8102E] focus:outline-none focus:ring-2 focus:ring-[#C8102E]"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4" role="navigation" aria-label="Navigation mobile">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`block px-3 py-2.5 rounded-md text-base font-medium transition-colors ${
            currentPath === link.href
              ? 'text-[#C8102E] font-semibold bg-red-50'
              : 'text-[#5a5a5a] hover:text-[#C8102E] hover:bg-red-50'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a href={link('/contact')} class="mt-3 btn-primary block text-center">
        Devis gratuit
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
