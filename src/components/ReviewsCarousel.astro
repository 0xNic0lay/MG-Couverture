---
const reviews = [
  {
    name: 'Alain Asselin',
    rating: 5,
    date: 'Il y a 6 mois',
    text: "Nous sommes tout à fait satisfaits de l'intervention de Mr Grenêche (et de sa collaboratrice qui assure le secrétariat). Travail bien fait, gentillesse, professionnalisme, et ne pouvons que conseiller cette entreprise. Pour info : l'intervention consistait au changement de 4 Velux dont un avec volet roulant électrique.",
  },
  {
    name: 'Aurore B.',
    rating: 5,
    date: 'Il y a 6 mois',
    text: "Mickaël est intervenu sur ma toiture il y a quelques temps, après une tempête. J'avais fait appel à une première entreprise qui avait bâclé le travail. J'ai donc fait appel à Mickaël qui a été très réactif et très professionnel. Je recommande à 100%.",
  },
  {
    name: 'Frédéric Ledouble',
    rating: 5,
    date: 'Il y a 3 mois',
    text: "Je recommande vivement cette entreprise : intervention en urgence suite à une fuite d'eau, puis programmation des travaux qui ont été parfaitement réalisés. Je suis très satisfait.",
  },
  {
    name: 'Anaïs Vié',
    rating: 5,
    date: 'Il y a 3 mois',
    text: "Suite à la tempête, 1 tuile de notre toit était tombée et l'intervention a pu se faire très rapidement (lendemain de mon appel). Je suis satisfaite. Merci beaucoup.",
  },
  {
    name: 'Christian Morel',
    rating: 5,
    date: 'Il y a 5 mois',
    text: "J'ai eu les coordonnées de MG Couverture sur les conseils d'une entreprise locale. L'urgence de la situation catastrophique de la toiture de ma grange a été traitée d'une main de maître, tant sur la réactivité, que sur la gestion administrative, la qualité du travail réalisé sur un bâti très ancien et des relations humaines de très grande qualité. Merci à toute l'équipe et à très bientôt.",
  },
];

const totalReviews = reviews.length;
---

<section class="py-20 px-4 bg-white" aria-labelledby="reviews-title">
  <div class="max-w-5xl mx-auto">

    <!-- En-tête -->
    <div class="text-center mb-12">
      <h2 id="reviews-title" class="section-title">Ils nous font confiance</h2>
      <div class="flex items-center justify-center gap-3 mt-3">
        <!-- Badge note globale -->
        <div class="inline-flex items-center gap-2 bg-[#fdf9f9] border border-red-100 rounded-full px-4 py-1.5">
          <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          <span class="font-bold text-[#3D3D3D]">5 / 5</span>
          <span class="text-[#5a5a5a] text-sm">· {totalReviews} avis Google</span>
          <!-- Logo Google simplifié -->
          <svg class="w-4 h-4 ml-1" viewBox="0 0 24 24" aria-label="Google">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Carrousel -->
    <div class="relative" role="region" aria-label="Avis clients" aria-roledescription="carrousel">

      <!-- Conteneur des slides -->
      <div class="overflow-hidden rounded-2xl">
        <ul
          id="carousel-track"
          class="flex transition-transform duration-500 ease-in-out"
          aria-live="polite"
        >
          {reviews.map((review, i) => (
            <li
              class="min-w-full px-2"
              role="group"
              aria-roledescription="diapositive"
              aria-label={`Avis ${i + 1} sur ${totalReviews}`}
            >
              <div class="bg-[#fdf9f9] border border-red-100 rounded-2xl p-8 md:p-10">
                <!-- Étoiles -->
                <div class="flex gap-1 mb-5" role="img" aria-label={`${review.rating} étoiles sur 5`}>
                  {Array.from({ length: 5 }).map(() => (
                    <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  ))}
                </div>

                <!-- Texte -->
                <blockquote>
                  <p class="text-[#3D3D3D] text-lg leading-relaxed mb-6 italic">
                    "{review.text}"
                  </p>
                  <footer class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                      <!-- Avatar initiale -->
                      <div
                        class="w-10 h-10 rounded-full bg-[#C8102E] text-white flex items-center justify-center font-bold text-sm shrink-0"
                        aria-hidden="true"
                      >
                        {review.name.charAt(0).toUpperCase()}
                      </div>
                      <div>
                        <cite class="not-italic font-semibold text-[#3D3D3D] block">{review.name}</cite>
                        <span class="text-[#5a5a5a] text-sm">{review.date}</span>
                      </div>
                    </div>
                    <!-- Logo Google -->
                    <svg class="w-6 h-6 opacity-40" viewBox="0 0 24 24" aria-label="Avis Google">
                      <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                      <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                      <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                      <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                    </svg>
                  </footer>
                </blockquote>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- Boutons prev / next -->
      <button
        id="carousel-prev"
        class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 md:-translate-x-6 w-11 h-11 bg-white border border-gray-200 rounded-full shadow-md flex items-center justify-center text-[#3D3D3D] hover:border-[#C8102E] hover:text-[#C8102E] transition-colors focus:outline-none focus:ring-2 focus:ring-[#C8102E]"
        aria-label="Avis précédent"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>

      <button
        id="carousel-next"
        class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 md:translate-x-6 w-11 h-11 bg-white border border-gray-200 rounded-full shadow-md flex items-center justify-center text-[#3D3D3D] hover:border-[#C8102E] hover:text-[#C8102E] transition-colors focus:outline-none focus:ring-2 focus:ring-[#C8102E]"
        aria-label="Avis suivant"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    </div>

    <!-- Points de navigation -->
    <div class="flex justify-center gap-2 mt-6" role="tablist" aria-label="Navigation des avis">
      {reviews.map((_, i) => (
        <button
          class={`carousel-dot w-2.5 h-2.5 rounded-full transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-[#C8102E] ${i === 0 ? 'bg-[#C8102E] w-6' : 'bg-gray-300'}`}
          data-index={i}
          aria-label={`Aller à l'avis ${i + 1}`}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
        />
      ))}
    </div>

  </div>
</section>

<script>
  const track = document.getElementById('carousel-track') as HTMLElement;
  const prevBtn = document.getElementById('carousel-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('carousel-next') as HTMLButtonElement;
  const dots = document.querySelectorAll<HTMLButtonElement>('.carousel-dot');
  const total = dots.length;
  let current = 0;
  let autoTimer: ReturnType<typeof setInterval>;

  function goTo(index: number) {
    current = (index + total) % total;
    track.style.transform = `translateX(-${current * 100}%)`;
    dots.forEach((dot, i) => {
      const active = i === current;
      dot.classList.toggle('bg-[#C8102E]', active);
      dot.classList.toggle('w-6', active);
      dot.classList.toggle('bg-gray-300', !active);
      dot.setAttribute('aria-selected', String(active));
    });
  }

  function resetTimer() {
    clearInterval(autoTimer);
    autoTimer = setInterval(() => goTo(current + 1), 5000);
  }

  prevBtn.addEventListener('click', () => { goTo(current - 1); resetTimer(); });
  nextBtn.addEventListener('click', () => { goTo(current + 1); resetTimer(); });
  dots.forEach(dot => {
    dot.addEventListener('click', () => { goTo(Number(dot.dataset.index)); resetTimer(); });
  });

  // Swipe tactile
  let startX = 0;
  track.addEventListener('touchstart', e => { startX = e.touches[0].clientX; }, { passive: true });
  track.addEventListener('touchend', e => {
    const diff = startX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) { goTo(diff > 0 ? current + 1 : current - 1); resetTimer(); }
  });

  // Auto-avance
  autoTimer = setInterval(() => goTo(current + 1), 5000);

  // Pause au survol
  track.addEventListener('mouseenter', () => clearInterval(autoTimer));
  track.addEventListener('mouseleave', resetTimer);
</script>
