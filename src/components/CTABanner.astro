---
interface Props {
  title?: string;
  subtitle?: string;
  btnLabel?: string;
  btnHref?: string;
}

const {
  title = 'Votre projet toiture ? Parlons-en !',
  subtitle = 'Devis gratuit et sans engagement. Réponse sous 24h.',
  btnLabel = 'Nous contacter',
  btnHref = '/contact',
} = Astro.props;
---

<section class="bg-[#C8102E] py-16 px-4">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{title}</h2>
    <p class="text-red-100 text-lg mb-8">{subtitle}</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href={btnHref} class="btn-secondary">
        {btnLabel}
      </a>
      <a href="tel:0670635484" class="inline-flex items-center justify-center gap-2 bg-white/20 hover:bg-white/30 text-white font-semibold px-6 py-3 rounded-lg transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        06.70.63.54.84
      </a>
    </div>
  </div>
</section>
