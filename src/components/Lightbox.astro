---
---

<dialog
  id="lightbox"
  class="fixed inset-0 w-full h-full max-w-none max-h-none m-0 p-0 bg-transparent backdrop:bg-black/90 z-50"
  aria-label="Visionneuse photo"
  aria-modal="true"
>
  <div class="w-full h-full flex flex-col items-center justify-center p-4 md:p-8" id="lightbox-backdrop">

    <!-- Fermer -->
    <button
      id="lightbox-close"
      class="absolute top-4 right-4 w-10 h-10 bg-white/10 hover:bg-white/25 text-white rounded-full flex items-center justify-center transition-colors focus:outline-none focus:ring-2 focus:ring-white z-10"
      aria-label="Fermer"
      type="button"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- Compteur -->
    <div class="absolute top-4 left-1/2 -translate-x-1/2 bg-white/10 text-white text-sm font-medium px-3 py-1 rounded-full" aria-live="polite">
      <span id="lightbox-counter">1 / 1</span>
    </div>

    <!-- Image principale -->
    <div class="relative w-full max-w-5xl flex items-center justify-center">
      <div id="lightbox-track" class="w-full overflow-hidden rounded-lg">
        <div id="lightbox-slides" class="flex transition-transform duration-300 ease-in-out">
          <!-- Slides injectées par JS -->
        </div>
      </div>

      <!-- Flèche gauche -->
      <button
        id="lightbox-prev"
        class="absolute -left-2 md:-left-14 w-11 h-11 bg-white/10 hover:bg-white/25 text-white rounded-full flex items-center justify-center transition-colors focus:outline-none focus:ring-2 focus:ring-white shrink-0"
        aria-label="Photo précédente"
        type="button"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>

      <!-- Flèche droite -->
      <button
        id="lightbox-next"
        class="absolute -right-2 md:-right-14 w-11 h-11 bg-white/10 hover:bg-white/25 text-white rounded-full flex items-center justify-center transition-colors focus:outline-none focus:ring-2 focus:ring-white shrink-0"
        aria-label="Photo suivante"
        type="button"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    </div>

    <!-- Miniatures -->
    <div id="lightbox-thumbs" class="flex gap-2 mt-4 max-w-5xl overflow-x-auto pb-1"></div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const slidesEl = document.getElementById('lightbox-slides') as HTMLElement;
  const thumbsEl = document.getElementById('lightbox-thumbs') as HTMLElement;
  const counter = document.getElementById('lightbox-counter') as HTMLElement;
  const prevBtn = document.getElementById('lightbox-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('lightbox-next') as HTMLButtonElement;
  const closeBtn = document.getElementById('lightbox-close') as HTMLButtonElement;
  const backdrop = document.getElementById('lightbox-backdrop') as HTMLElement;

  let photos: string[] = [];
  let current = 0;

  function render() {
    slidesEl.innerHTML = photos.map(src => `
      <div class="min-w-full flex items-center justify-center">
        <img
          src="${src}"
          alt="Photo de réalisation"
          class="max-h-[75vh] max-w-full object-contain rounded-lg select-none"
          draggable="false"
        />
      </div>
    `).join('');

    thumbsEl.innerHTML = photos.map((src, i) => `
      <button
        class="lightbox-thumb shrink-0 w-14 h-14 rounded overflow-hidden border-2 transition-all focus:outline-none ${i === current ? 'border-white opacity-100' : 'border-transparent opacity-50 hover:opacity-80'}"
        data-i="${i}"
        type="button"
        aria-label="Photo ${i + 1}"
      >
        <img src="${src}" class="w-full h-full object-cover" draggable="false" />
      </button>
    `).join('');

    thumbsEl.querySelectorAll<HTMLButtonElement>('.lightbox-thumb').forEach(btn => {
      btn.addEventListener('click', () => goTo(Number(btn.dataset.i)));
    });
  }

  function goTo(i: number) {
    current = (i + photos.length) % photos.length;
    (slidesEl as HTMLElement).style.transform = `translateX(-${current * 100}%)`;
    counter.textContent = `${current + 1} / ${photos.length}`;

    thumbsEl.querySelectorAll<HTMLElement>('.lightbox-thumb').forEach((btn, idx) => {
      btn.classList.toggle('border-white', idx === current);
      btn.classList.toggle('opacity-100', idx === current);
      btn.classList.toggle('border-transparent', idx !== current);
      btn.classList.toggle('opacity-50', idx !== current);
    });

    // Cacher flèches si 1 seule photo
    const single = photos.length <= 1;
    prevBtn.style.display = single ? 'none' : '';
    nextBtn.style.display = single ? 'none' : '';
    thumbsEl.style.display = single ? 'none' : '';
  }

  function open(newPhotos: string[], startIndex: number) {
    photos = newPhotos;
    current = startIndex;
    render();
    goTo(current);
    dialog.showModal();
    document.body.style.overflow = 'hidden';
  }

  function close() {
    dialog.close();
    document.body.style.overflow = '';
  }

  // Déclencheurs sur les cartes
  document.addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-lightbox-open]');
    if (!btn) return;
    const p = JSON.parse(btn.dataset.photos ?? '[]') as string[];
    const i = Number(btn.dataset.index ?? 0);
    open(p, i);
  });

  prevBtn.addEventListener('click', () => goTo(current - 1));
  nextBtn.addEventListener('click', () => goTo(current + 1));
  closeBtn.addEventListener('click', close);

  // Clic sur le fond pour fermer
  backdrop.addEventListener('click', e => {
    if (e.target === backdrop) close();
  });

  // Clavier
  document.addEventListener('keydown', e => {
    if (!dialog.open) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') goTo(current - 1);
    if (e.key === 'ArrowRight') goTo(current + 1);
  });

  // Swipe mobile
  let touchStartX = 0;
  slidesEl.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
  slidesEl.addEventListener('touchend', e => {
    const diff = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) goTo(diff > 0 ? current + 1 : current - 1);
  });
</script>
