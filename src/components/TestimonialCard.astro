---
interface Props {
  name: string;
  city: string;
  rating: number;
  text: string;
}

const { name, city, rating, text } = Astro.props;
---

<article class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
  <!-- Stars -->
  <div class="flex gap-1 mb-4" aria-label={`Note : ${rating} étoiles sur 5`}>
    {Array.from({ length: 5 }).map((_, i) => (
      <svg
        class={`w-5 h-5 ${i < rating ? 'text-amber-400' : 'text-gray-200'}`}
        fill="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
    ))}
  </div>
  <blockquote>
    <p class="text-[#5a5a5a] leading-relaxed mb-4 italic">"{text}"</p>
    <footer>
      <cite class="not-italic font-semibold text-[#3D3D3D] text-sm">{name}</cite>
      <span class="text-gray-400 text-sm"> — {city}</span>
    </footer>
  </blockquote>
</article>
