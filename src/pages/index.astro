---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';
import CTABanner from '../components/CTABanner.astro';
import { asset, link } from '../utils/asset';

const services = [
  {
    title: 'Pose de toiture neuve',
    description: 'Construction et installation complète de toiture pour vos projets neufs. Tuiles, ardoise, bac acier — tous matériaux maîtrisés.',
    icon: `<svg class="w-6 h-6 text-[#C8102E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
  },
  {
    title: 'Rénovation de toiture',
    description: "Remise en état complète ou partielle de votre toiture existante. Remplacement de tuiles, reprise d'étanchéité, purge et repose.",
    icon: `<svg class="w-6 h-6 text-[#C8102E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`,
  },
  {
    title: 'Zinguerie',
    description: 'Pose et réparation de gouttières, chéneaux, faîtières et solins. Travaux de zinguerie soignés pour une étanchéité parfaite.',
    icon: `<svg class="w-6 h-6 text-[#C8102E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/></svg>`,
  },
  {
    title: 'Dépannage urgent',
    description: "Fuite, tuile cassée, infiltration — intervention rapide pour sécuriser votre toiture et stopper les dégâts. Disponible rapidement.",
    icon: `<svg class="w-6 h-6 text-[#C8102E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
  },
];

const trustItems = [
  { label: 'Devis gratuit', icon: `<svg class="w-7 h-7 text-[#C8102E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>` },
  { label: 'Intervention rapide', icon: `<svg class="w-7 h-7 text-[#C8102E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>` },
  { label: "+15 ans d'expérience", icon: `<svg class="w-7 h-7 text-[#C8102E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>` },
  { label: 'Garantie décennale', icon: `<svg class="w-7 h-7 text-[#C8102E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>` },
];

---

<BaseLayout
  title="MG Couverture — Artisan Couvreur à Orléans (45) | Devis Gratuit"
  description="MG Couverture, artisan couvreur à Orléans et agglomération orléanaise. Pose, rénovation, zinguerie, isolation, Velux et dépannage d'urgence. Devis gratuit et sans engagement. Garantie décennale."
>
  <Header />
  <main>
    <Hero />

    <!-- Bandeau de confiance -->
    <section class="bg-[#fdf9f9] border-y border-red-100 py-8 px-4">
      <div class="max-w-5xl mx-auto">
        <ul class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          {trustItems.map(item => (
            <li class="flex flex-col items-center gap-2">
              <div aria-hidden="true">
                <Fragment set:html={item.icon} />
              </div>
              <span class="font-semibold text-[#3D3D3D] text-sm">{item.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Services -->
    <section class="py-20 px-4 bg-white" aria-labelledby="services-title">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 id="services-title" class="section-title">Nos prestations</h2>
          <p class="section-subtitle max-w-2xl mx-auto">
            Du dépannage d'urgence à la toiture neuve — MG Couverture intervient sur tous vos projets à Orléans et dans l'agglomération.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {services.map(service => (
            <ServiceCard
              title={service.title}
              description={service.description}
              icon={service.icon}
            />
          ))}
        </div>
        <div class="text-center mt-10">
          <a href={link('/services')} class="btn-outline">
            Voir tous nos services
          </a>
        </div>
      </div>
    </section>

    <!-- À propos courte -->
    <section class="py-20 px-4 bg-[#fdf9f9]" aria-labelledby="about-title">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <img
              src={asset('/images/mickael.jpg')}
              alt="Mickaël Grenêche, artisan couvreur MG Couverture à Orléans"
              class="rounded-2xl w-full object-cover shadow-lg"
              loading="lazy"
              width="500"
              height="600"
            />
          </div>
          <div>
            <span class="text-[#C8102E] font-semibold text-sm uppercase tracking-wide">Artisan local</span>
            <h2 id="about-title" class="text-3xl font-bold text-[#3D3D3D] mt-2 mb-6">
              Un couvreur de confiance, ancré dans la région orléanaise
            </h2>
            <p class="text-[#5a5a5a] leading-relaxed mb-4">
              Je suis Mickaël Grenêche, artisan couvreur indépendant installé à Orléans. Avec plus de 15 ans de métier, j'ai fait de la toiture ma passion et mon engagement quotidien envers mes clients.
            </p>
            <p class="text-[#5a5a5a] leading-relaxed mb-6">
              Chaque chantier est unique. Je m'adapte à vos contraintes, à votre budget et à votre maison pour vous proposer le meilleur travail possible — dans les règles de l'art, avec les matériaux qui vous conviennent.
            </p>
            <ul class="space-y-2 mb-8">
              {["Devis gratuit et sans engagement", "Intervention rapide sur Orléans et environs", "Travail soigné avec garantie décennale", "Artisan local disponible et réactif"].map(item => (
                <li class="flex items-center gap-2 text-[#5a5a5a] text-sm">
                  <svg class="w-5 h-5 text-[#C8102E] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
            <a href={link('/a-propos')} class="btn-outline">
              En savoir plus
            </a>
          </div>
        </div>
      </div>
    </section>

    <ReviewsCarousel />

    <CTABanner />
  </main>
  <Footer />
</BaseLayout>
